# Bolge Stratejisi - ornek ortam dosyasi. GERCEK SIR YOKTUR: asagidaki degerler yer tutucudur, uretimde DEGISTIRIN.
# Kullanim:  cp deploy/.env.ornek deploy/.env   (deploy/.env git'e GIRMEZ)   sonra   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d

# --- zorunlu sirlar -----------------------------------------------------------------------------------------------
# Postgres sifresi. BOLGE_PG_URL'e girer: URL'de ozel karakter kullanmayin (ya da yuzde-kodlayin).
PG_SIFRE=degistir-uzun-rastgele-pg-sifresi
# ws bileti ve giris baglantisi imza sirri (en az 32 karakter; BOLGE_URETIM=1 iken 'degistir...' / 'gelistirme...' ile baslayan deger reddedilir).
# Uretimde gelistirme kimligi KAPALIDIR: eski GELISTIRME_SIRRI artik kullanilmaz (verilirse yok sayilir).
BILET_SIRRI=degistir-en-az-32-karakterlik-rastgele-bilet-sirri
# Sir degistirirken (rotasyon) eski sir burada kalir; eski sir yalniz dogrular. Bos birakilabilir.
BILET_SIRRI_ESKI=
# Origin izin listesi (virgullu; /giris/ POST'lari ve ws icin) ve postadaki baglantinin genel https adresi: ikisi de ZORUNLU.
IZINLI_KOKENLER=https://degistir.ornek.org
GENEL_URL=https://degistir.ornek.org
# /metrik Bearer token'i (en az 16 karakter; loopback disi metrik adresi icin zorunlu).
METRIK_TOKEN=degistir-uzun-rastgele-metrik-tokeni

# --- isteğe bagli (varsayilanlar compose'ta) ----------------------------------------------------------------------
# Dunya haritasi ve kipi: mini | sentetik | gercek[:ad]; BOLGE_PARSEL=1 mulk kipi (mini ve sentetik harita icin).
BOLGE_HARITA=sentetik
BOLGE_PARSEL=0
# Yalniz YENI dunyada: duvar saati epoch'u (bir Turkiye gece yarisi). Bos = varsayilan 2026-09-30T21:00:00Z (1 Ekim 2026 00:00 TRT).
BOLGE_DUNYA_EPOCH=
# Dunya adi (ayni veritabaninda birden cok dunya olabilir) ve ilk acilis tohumu.
BOLGE_DUNYA=ana
BOLGE_TOHUM=1
# Icerik gocu (kural donemi): YALNIZ donem sinirinda, once yedek alin; bkz. README "Kural donemi provasi". 1 = acik.
BOLGE_GOC=0
# Anlik goruntu isci is parcacigi (1 = acik, vars.): serilestirme/ozet/gzip ana donguyu tutmaz. 0 = ana dongude (tani).
BOLGE_GORUNTU_ISCI=1
# Esnaf Defteri odul dedektoru (1 = acik, vars.): kavramlar saptaninca sistem_odul gunluge girer. 0 = kapali.
BOLGE_ODUL=1
# Davetli listesi (Alfa-0 kayit kapisi; KISISEL VERI, git'e girmez). Bos = kayit acik (yalniz e-posta dogrulamasi). Dolu ise yalniz listedeki
# adreslere giris baglantisi gider. DAVET_DIZIN ana makinedeki dizin (varsayilan deploy/davet, git disi), DAVETLI_LISTE_DOSYA o dizindeki dosya adi
# (satir basina bir e-posta, '#' aciklama). Liste imaja girmez, degisince: docker compose restart sunucu. Alfa-0 sonunda silinmeli (KVKK).
DAVET_DIZIN=./davet
DAVETLI_LISTE_DOSYA=
# Insan testi: 1 = oyun baglantisi oturum olay kaydi (yalniz zaman ve opak oyuncu kimligi). Test dunyasi ayri BOLGE_DUNYA=test_<ad> ile acilir;
# test bitince `--test-dunya-sil test_<ad>` tum izleri siler (packages/sunucu/README.md kontrol listesi adim 13).
OTURUM_KAYDI=0
# Sunucu bir ters vekilin (Cloudflare, Caddy, nginx) arkasindaysa 1: IP, X-Forwarded-For'un son ogesinden alinir (hiz siniri icin).
GUVENILIR_PROXY=0
# Yayinlanan portlar (yalniz localhost'a baglanir; disariya ters vekil/TLS ile acin).
SUNUCU_PORT=8787
METRIK_YAYIN_PORT=9464
