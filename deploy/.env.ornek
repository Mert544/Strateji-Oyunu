# Bolge Stratejisi - ornek ortam dosyasi. GERCEK SIR YOKTUR: asagidaki degerler yer tutucudur, uretimde DEGISTIRIN.
# Kullanim:  cp deploy/.env.ornek deploy/.env   (deploy/.env git'e GIRMEZ)   sonra   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d

# --- zorunlu sirlar -----------------------------------------------------------------------------------------------
# Postgres sifresi. BOLGE_PG_URL'e girer: URL'de ozel karakter kullanmayin (ya da yuzde-kodlayin).
PG_SIFRE=degistir-uzun-rastgele-pg-sifresi
# Oyuncu token imza sirri (en az 16 karakter; BOLGE_URETIM=1 iken varsayilan deger reddedilir).
GELISTIRME_SIRRI=degistir-uzun-rastgele-imza-sirri
# /metrik Bearer token'i (en az 16 karakter; loopback disi metrik adresi icin zorunlu).
METRIK_TOKEN=degistir-uzun-rastgele-metrik-tokeni

# --- isteğe bagli (varsayilanlar compose'ta) ----------------------------------------------------------------------
# Dunya haritasi ve kipi: mini | sentetik | gercek[:ad]; BOLGE_PARSEL=1 mulk kipi (mini ve sentetik harita icin).
BOLGE_HARITA=sentetik
BOLGE_PARSEL=0
# Yalniz YENI dunyada: duvar saati epoch'u (bir Turkiye gece yarisi). Bos = varsayilan 2026-09-30T21:00:00Z (1 Ekim 2026 00:00 TRT).
BOLGE_DUNYA_EPOCH=
# Dunya adi (ayni veritabaninda birden cok dunya olabilir) ve ilk acilis tohumu.
BOLGE_DUNYA=ana
BOLGE_TOHUM=1
# Icerik gocu (kural donemi): YALNIZ donem sinirinda, once yedek alin; bkz. README "Kural donemi provasi". 1 = acik.
BOLGE_GOC=0
# Yayinlanan portlar (yalniz localhost'a baglanir; disariya ters vekil/TLS ile acin).
SUNUCU_PORT=8787
METRIK_YAYIN_PORT=9464
